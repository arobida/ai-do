{
  "name": "@dibs.ai/dibs",
  "version": "0.1.0",
  "description": "Shared task store for coding agents: CLI, MCP server and todo.txt, with plugins for Claude Code, opencode, Pi, Codex and Cursor.",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "keywords": [
    "dibs",
    "ai-agents",
    "coding-agent",
    "task-manager",
    "todo",
    "todo.txt",
    "mcp",
    "mcp-server",
    "claude-code",
    "claude-code-plugin",
    "opencode",
    "opencode-plugin",
    "pi-package",
    "pi",
    "codex",
    "cursor",
    "dex",
    "things"
  ],
  "bin": {
    "dibs": "./src/cli/index.ts"
  },
  "files": [
    "src/",
    "schema.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "bun test",
    "check": "tsc && bun test",
    "build:agent": "bun scripts/build-agent.ts",
    "pack:check": "bun pm pack --dry-run"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@earendil-works/pi-tui": "^1.5.2",
    "@types/bun": "^1.4.4",
    "typebox": "^1.4.7",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "author": {
    "name": "arobida",
    "url": "https://github.com/arobida"
  },
  "engines": {
    "bun": ">=1.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "workspaces": [
    "agents/pi",
    "agents/opencode"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arobida/dibs.git"
  },
  "homepage": "https://github.com/arobida/dibs#readme",
  "bugs": {
    "url": "https://github.com/arobida/dibs/issues"
  },
  "exports": {
    ".": "./src/core/tasks.ts",
    "./core/*": "./src/core/*"
  }
}
