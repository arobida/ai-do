{
  "name": "ai-do",
  "version": "0.1.0",
  "description": "Standalone task panel and task tools for Pi, with optional Dex integration.",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "keywords": [
    "pi-package",
    "pi",
    "dex",
    "tasks"
  ],
  "bin": {
    "ai-do": "./src/cli/index.ts"
  },
  "files": [
    "src/",
    "agents/",
    "scripts/",
    "schema.json",
    "README.md",
    "CHANGELOG.md"
  ],
  "pi": {
    "extensions": [
      "./agents/pi/index.ts"
    ]
  },
  "scripts": {
    "test": "bun test",
    "check": "tsc && bun test",
    "build:agent": "bun scripts/build-agent.ts",
    "pack:check": "bun pm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@earendil-works/pi-tui": "^1.5.2",
    "@types/bun": "^1.4.4",
    "typebox": "^1.4.7",
    "typescript": "^7.0.2"
  },
  "license": "MIT",
  "author": {
    "name": "arobida",
    "url": "https://github.com/arobida"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "engines": {
    "bun": ">=1.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
